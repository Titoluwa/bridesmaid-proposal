# ==============================================================================
# Environment Configuration - Bridesmaid Proposal Website (Tolu & Moyo)
# ==============================================================================
# Copy this file to `.env.local` for local development or set these variables in
# your hosting provider (e.g. Vercel, Neon, Railway).

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION (Optional in dev, Recommended in production)
# ------------------------------------------------------------------------------
# Neon / Postgres connection string.
# If omitted during local development, responses and assigned colors will
# automatically save to a local JSON file at `.data/responses.json`.
# In production (e.g. Vercel), provide your Neon / Postgres URL so responses persist.
DATABASE_URL="postgresql://neondb_owner:your_password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION (Recommended)
# ------------------------------------------------------------------------------
# Password used to log in to the private admin dashboard at `/admin`.
# If not set in development, the dashboard is open for convenience.
# In production, set this to a secure password.
ADMIN_PASSWORD="choose_a_secure_admin_password"

# ------------------------------------------------------------------------------
# 3. WEDDING COUNTDOWN (Optional)
# ------------------------------------------------------------------------------
# Target date for the wedding. If left empty, the final screen simply displays
# "The countdown begins..." without a numeric counter.
# If provided, a live Days/Hours/Minutes/Seconds countdown will display.
# Format: YYYY-MM-DD or full ISO 8601 string (e.g., 2027-04-17T12:00:00+01:00).
NEXT_PUBLIC_WEDDING_DATE="2027-04-17"

# ------------------------------------------------------------------------------
# 4. EMAIL / SMTP (For sending keepsake card emails)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="titoluwaranti@gmail.com"
SMTP_PASSWORD="your-google-app-password"
SMTP_FROM="Tolu's Bridal Party <titoluwaranti@gmail.com>"